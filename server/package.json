{
  "name": "server",
  "version": "0.0.0",
  "bin": "index.ts",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "esbuild": "npx esbuild index.ts --bundle --platform=node --format=cjs --outfile=./dist/bundle.js",
    "pkg": "pkg dist/bundle.js --targets node20-win-x64 --fallback-to-source --output ../dist/picture-sync.exe"
  },
  "pkg": {
    "scripts": [
      "node_modules/express/**/*.js",
      "node_modules/express/lib/view.js"
    ]
  },
  "type": "commonjs",
  "dependencies": {
    "express": "^4.19.2",
    "vercel": "^59.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "@yao-pkg/pkg": "^6.22.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
